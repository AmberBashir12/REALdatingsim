  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
    text: 'I''m a little upset I walked all the way up here for this.'
    actions:
    - speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
      spriteIndex: 12
      actionType: 0
      coords: {x: -450, y: 0}
