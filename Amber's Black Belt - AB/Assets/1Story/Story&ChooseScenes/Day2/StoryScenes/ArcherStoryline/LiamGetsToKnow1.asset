      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: e8c7f87539da8214c83b55c1be44b282, type: 2}
    text: '...I know. She told me. She tells me everything.'
    actions:
    - speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
      spriteIndex: 12
      actionType: 0
      coords: {x: -450, y: 0}
