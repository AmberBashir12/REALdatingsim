    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
    text: 'So how did you and Archer even become friends?'
    actions:
    - speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
      spriteIndex: 12
      actionType: 0
      coords: {x: -450, y: 0}
      moveSpeed: 0
      tintColor: {r: 0, g: 0, b: 0, a: 0}
      tintOpacity: 0
    - speaker: {fileID: 11400000, guid: e8c7f87539da8214c83b55c1be44b282, type: 2}
      spriteIndex: 0
      actionType: 0
      coords: {x: 450, y: 0}
      moveSpeed: 0
      tintColor: {r: 0, g: 0, b: 0, a: 0}
      tintOpacity: 0
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: e8c7f87539da8214c83b55c1be44b282, type: 2}
    text: '...He moved in next door when we were six. He knocked on our door and asked if I wanted to play.'
    actions:
    - speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
      spriteIndex: 12
      actionType: 0
      coords: {x: -450, y: 0}
      moveSpeed: 0
      tintColor: {r: 0, g: 0, b: 0, a: 0}
      tintOpacity: 0
    - speaker: {fileID: 11400000, guid: e8c7f87539da8214c83b55c1be44b282, type: 2}
      spriteIndex: 0
      actionType: 0
      coords: {x: 450, y: 0}
      moveSpeed: 0
      tintColor: {r: 0, g: 0, b: 0, a: 0}
      tintOpacity: 0
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
    text: 'And you said?'
    actions:
    - speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
      spriteIndex: 12
      actionType: 0
      coords: {x: -450, y: 0}
      moveSpeed: 0
      tintColor: {r: 0, g: 0, b: 0, a: 0}
      tintOpacity: 0
    - speaker: {fileID: 11400000, guid: e8c7f87539da8214c83b55c1be44b282, type: 2}
      spriteIndex: 0
      actionType: 0
      coords: {x: 450, y: 0}
      moveSpeed: 0
      tintColor: {r: 0, g: 0, b: 0, a: 0}
      tintOpacity: 0
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: e8c7f87539da8214c83b55c1be44b282, type: 2}
    text: '...Nothing. He decided we were friends anyway.'
    actions:
    - speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
      spriteIndex: 12
      actionType: 0
      coords: {x: -450, y: 0}
      moveSpeed: 0
      tintColor: {r: 0, g: 0, b: 0, a: 0}
      tintOpacity: 0
    - speaker: {fileID: 11400000, guid: e8c7f87539da8214c83b55c1be44b282, type: 2}
      spriteIndex: 0
      actionType: 0
      coords: {x: 450, y: 0}
      moveSpeed: 0
      tintColor: {r: 0, g: 0, b: 0, a: 0}
