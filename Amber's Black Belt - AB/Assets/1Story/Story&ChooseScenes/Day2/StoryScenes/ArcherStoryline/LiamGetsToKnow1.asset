  sentences:
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 359f5f6b302fa244c8f52d53c2279cfe, type: 2}
    text: 'A few days of pretending later, you''ve gotten used to Liam''s silence. It''s not awkward. It''s a quiet that doesn''t ask anything of you.'
    actions:
    - speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
      spriteIndex: 12
      actionType: 1
      coords: {x: -450, y: 0}
      moveSpeed: 0
      tintColor: {r: 0, g: 0, b: 0, a: 0}
      tintOpacity: 0
    - speaker: {fileID: 11400000, guid: e8c7f87539da8214c83b55c1be44b282, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 450, y: 0}
      moveSpeed: 0
      tintColor: {r: 0, g: 0, b: 0, a: 0}
      tintOpacity: 0
    choice:
