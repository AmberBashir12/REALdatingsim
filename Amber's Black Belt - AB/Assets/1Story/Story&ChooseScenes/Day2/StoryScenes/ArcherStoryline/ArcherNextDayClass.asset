    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
    text: 'The teacher has not even started yet.'
    actions:
    - speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
      spriteIndex: 12
      actionType: 0
