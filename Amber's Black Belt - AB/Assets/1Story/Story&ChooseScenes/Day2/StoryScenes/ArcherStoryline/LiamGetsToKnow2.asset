    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: e8c7f87539da8214c83b55c1be44b282, type: 2}
    text: '...He''d tell everyone. Make it a big thing. He doesn''t mean any harm. But I like things quiet.'
    actions:
    - speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
      spriteIndex: 12
      actionType: 0
      coords: {x: -450, y: 0}
