    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 9dfdcc12af69142438769df6e9e883eb, type: 2}
    text: '"If you ever have questions about classes, teachers, clubs, or even just
      where things are, you can always ask me or anyone on student council."'
