    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 9dfdcc12af69142438769df6e9e883eb, type: 2}
    text: "\"but you honestly don\u2019t have to have everything figured out right
      away. People are a lot more understanding than they seem.\""
    actions:
    - speaker: {fileID: 11400000, guid: 9dfdcc12af69142438769df6e9e883eb, type: 2}
      spriteIndex: 0
      actionType: 4
      coords: {x: 0, y: 0}
