  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 9dfdcc12af69142438769df6e9e883eb, type: 2}
    text: "\"I\u2019m really glad you\u2019re here. I know starting at a new school
      can be stressful\""
    actions:
    - speaker: {fileID: 11400000, guid: 9dfdcc12af69142438769df6e9e883eb, type: 2}
      spriteIndex: 0
      actionType: 4
      coords: {x: 0, y: 0}
