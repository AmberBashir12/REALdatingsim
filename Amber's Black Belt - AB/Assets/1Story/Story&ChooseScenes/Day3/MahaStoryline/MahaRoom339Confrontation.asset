  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 359f5f6b302fa244c8f52d53c2279cfe, type: 2}
    text: Tea spills across the cushions. Eleanor scrambles to save her guitar case.
    actions: []
    choice:
      prompt: 
