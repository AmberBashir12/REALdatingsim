  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
    text: What's Maha doing here?
    actions: []
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 80dcb48fbb1330d429e183522d24df8f, type: 2}
    text: I don't know. She just came in. Is everything okay?
    actions:
    - speaker: {fileID: 11400000, guid: 80dcb48fbb1330d429e183522d24df8f, type: 2}
      spriteIndex: -1
      actionType: 4
      coords: {x: 0, y: 0}
