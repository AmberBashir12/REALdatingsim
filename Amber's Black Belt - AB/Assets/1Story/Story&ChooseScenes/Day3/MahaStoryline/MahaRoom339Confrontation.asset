    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: a55e95743489d504eb111849913139e1, type: 2}
    text: Still hiding in here?
    actions: []
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
