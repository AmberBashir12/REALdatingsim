  m_Name: MahaWaitTomorrow
  m_EditorClassIdentifier: 
  sentences:
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: a55e95743489d504eb111849913139e1, type: 2}
    text: Wait a minute, {playerName}. I wanted to talk to you before you go.
    actions:
    - speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
      spriteIndex: 12
      actionType: 1
      coords: {x: -200, y: 0}
      moveSpeed: 0
      tintColor: {r: 0, g: 0, b: 0, a: 0}
      tintOpacity: 0
    - speaker: {fileID: 11400000, guid: a55e95743489d504eb111849913139e1, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 200, y: 0}
      moveSpeed: 0
      tintColor: {r: 0, g: 0, b: 0, a: 0}
      tintOpacity: 0
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
    text: Yeah, what's up?
    actions: []
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: a55e95743489d504eb111849913139e1, type: 2}
    text: Meet me outside Room 339 tomorrow. I want you to see something for yourself.
    actions: []
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
    text: Why there? Is this about Eleanor?
    actions: []
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: a55e95743489d504eb111849913139e1, type: 2}
    text: You'll understand when we're there. Just don't decide what happened before you hear me out.
    actions: []
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
    text: I don't love being dragged into something without knowing what it is.
    actions: []
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: a55e95743489d504eb111849913139e1, type: 2}
    text: Fair. I'm asking you to come because I trust you to listen, not because I expect you to take my side.
    actions: []
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
    text: Okay. I'll meet you there tomorrow.
    actions: []
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: a55e95743489d504eb111849913139e1, type: 2}
    text: Good. And {playerName}?
    actions: []
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
    text: Yeah?
    actions: []
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: a55e95743489d504eb111849913139e1, type: 2}
    text: Don't tell Eleanor I'm coming. Not yet.
    actions: []
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 359f5f6b302fa244c8f52d53c2279cfe, type: 2}
    text: The rest of the day passes, but Maha's request stays on your mind.
    actions: []
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
