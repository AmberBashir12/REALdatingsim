  sentences:
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: aeb00bc743a24afb90dffce6ca9a83f1, type: 2}
    text: Aria drops onto the edge of the fountain and lets out a long sigh.
    actions:
    - speaker: {fileID: 11400000, guid: aeb00bc743a24afb90dffce6ca9a83f1, type: 2}
      spriteIndex: 0
      actionType: 1
      coords: {x: 200, y: 0}
