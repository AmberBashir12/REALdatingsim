            prompt: 
            options: []
          endingScene: {fileID: 0}
        - followUpType: 0
          speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
          text: Yeah. I do.
          actions: []
          music: {fileID: 0}
          music2: {fileID: 0}
          sound: {fileID: 0}
          choice:
            prompt: 
            options: []
          endingScene: {fileID: 0}
        - followUpType: 0
          speaker: {fileID: 11400000, guid: aeb00bc743a24afb90dffce6ca9a83f1, type: 2}
          text: Then you have good taste. I could get used to having you all to myself.
          actions:
          - speaker: {fileID: 11400000, guid: aeb00bc743a24afb90dffce6ca9a83f1, type: 2}
            spriteIndex: -1
            actionType: 4
            coords: {x: 0, y: 0}
