    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: aeb00bc743a24afb90dffce6ca9a83f1, type: 2}
    text: Let's go here first! They have those little stalls you like.
    actions:
    - speaker: {fileID: 11400000, guid: aeb00bc743a24afb90dffce6ca9a83f1, type: 2}
      spriteIndex: -1
      actionType: 4
      coords: {x: 0, y: 0}
      moveSpeed: 0
      tintColor: {r: 0, g: 0, b: 0, a: 0}
      tintOpacity: 0
    choice:
