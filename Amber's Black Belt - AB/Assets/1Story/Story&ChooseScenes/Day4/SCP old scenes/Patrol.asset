    - speaker: {fileID: 11400000, guid: 31131cf5c56fa144b8d10d79464f4bf3, type: 2}
      spriteIndex: 0
      actionType: 0
      coords: {x: 200, y: 0}
      moveSpeed: 0
      tintColor: {r: 0, g: 0, b: 0, a: 0}
      tintOpacity: 0
    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 31131cf5c56fa144b8d10d79464f4bf3, type: 2}
    text: Respect is earned. Fear is borrowed.
    actions:
    - speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
      spriteIndex: 12
      actionType: 0
      coords: {x: -200, y: 0}
      moveSpeed: 0
