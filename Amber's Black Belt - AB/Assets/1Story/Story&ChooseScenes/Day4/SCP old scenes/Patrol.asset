    choice:
      prompt: 
      options: []
    endingScene: {fileID: 0}
    music: {fileID: 0}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 31131cf5c56fa144b8d10d79464f4bf3, type: 2}
    text: Now, the reception office. There is more to learn there.
    actions:
    - speaker: {fileID: 11400000, guid: 2e240942c73318642b0f986813494e10, type: 2}
