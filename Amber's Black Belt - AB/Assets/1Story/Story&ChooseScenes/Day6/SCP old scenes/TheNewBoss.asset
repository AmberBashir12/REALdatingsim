%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 658169cdd038f9a4b85d22255e392255, type: 3}
  m_Name: TheNewBoss
  m_EditorClassIdentifier: 
  sentences:
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 359f5f6b302fa244c8f52d53c2279cfe, type: 2}
    text: 'You walk into the estate beside the president without hesitation.'
    endingScene: {fileID: 0}
    music: {fileID: 8300000, guid: e97b35e781946114fa6ba274e2c8c49c, type: 3}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 359f5f6b302fa244c8f52d53c2279cfe, type: 2}
    text: 'Your hands do not shake. Your breathing does not change.'
    endingScene: {fileID: 0}
    music: {fileID: 8300000, guid: e97b35e781946114fa6ba274e2c8c49c, type: 3}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 359f5f6b302fa244c8f52d53c2279cfe, type: 2}
    text: 'When the Boss reaches for his desk drawer, you raise the gun first.'
    endingScene: {fileID: 0}
    music: {fileID: 8300000, guid: e97b35e781946114fa6ba274e2c8c49c, type: 3}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 359f5f6b302fa244c8f52d53c2279cfe, type: 2}
    text: 'You pull the trigger. It feels like nothing at all.'
    endingScene: {fileID: 0}
    music: {fileID: 8300000, guid: e97b35e781946114fa6ba274e2c8c49c, type: 3}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 359f5f6b302fa244c8f52d53c2279cfe, type: 2}
    text: 'The organization stands strong, and its men have no one else to follow.'
    endingScene: {fileID: 0}
    music: {fileID: 8300000, guid: e97b35e781946114fa6ba274e2c8c49c, type: 3}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 359f5f6b302fa244c8f52d53c2279cfe, type: 2}
    text: 'The president becomes the new Boss, without a single problem.'
    endingScene: {fileID: 0}
    music: {fileID: 8300000, guid: e97b35e781946114fa6ba274e2c8c49c, type: 3}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 359f5f6b302fa244c8f52d53c2279cfe, type: 2}
    text: 'She keeps the council. She keeps her promise. And she keeps you close.'
    endingScene: {fileID: 0}
    music: {fileID: 8300000, guid: e97b35e781946114fa6ba274e2c8c49c, type: 3}
    music2: {fileID: 0}
    sound: {fileID: 0}
  - sentenceType: 0
    speaker: {fileID: 11400000, guid: 359f5f6b302fa244c8f52d53c2279cfe, type: 2}
    text: 'Ending: The New Boss'
    endingScene: {fileID: 0}
    music: {fileID: 8300000, guid: e97b35e781946114fa6ba274e2c8c49c, type: 3}
    music2: {fileID: 0}
    sound: {fileID: 0}
  background: {fileID: 21300000, guid: a2fa8e2766ec7e04388956a325ba3c4d, type: 3}
  nextScene: {fileID: 0}
  alternativeScenes: []
  endingId: 468613c1e9eb4db09b764c7733718ce4
